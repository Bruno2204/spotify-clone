---
import { CardPlayButton } from '@/components/main/CardPlayButton.jsx';
import { PlaylistSongs } from '@/components/playlist/PlaylistSongs.jsx';
import Layout from '@/layouts/Layout.astro';

import { allPlaylists, songs } from '@/lib/data.js';

const { id } = Astro.params;
const playlist = allPlaylists.find((playlist) => playlist.id === id);
const playlistSongs = songs.filter(
  (song) => song.albumId === playlist?.albumId,
);
---

<Layout>
  <div
    id='playlist-container'
    class='relative transition-all duration-1000 bg-section-bg m-2 rounded-lg z-10 w-full overflow-x-hidden flex flex-col'
  >
    <header class='flex flex-row gap-4 items-center p-6 mt-5'>
      <picture class='size-40 aspect-square flex'>
        <img
          src={playlist?.cover}
          alt={playlist?.title}
          class='object-cover shadow-lg select-none'
          transition:name=`playlist-${id}-image`
        />
      </picture>
      <div class='flex flex-col gap-2'>
        <h1
          class='text-white text-4xl font-extrabold'
          transition:name=`playlist-${id}-title`
        >
          {playlist?.title}
        </h1>
        <p
          class='text-zinc-400 text-sm font-normal'
          transition:name=`playlist-${id}-artists`
        >
          {playlist?.artists.join(', ')}
        </p>
      </div>
    </header>

    <div
      class='flex ml-6 hover:scale-105 duration-300 ease-in-out w-fit'
      transition:name={`playlist-${id}-button`}
    >
      <CardPlayButton id={id} client:load className='size-6 m-1.5' />
    </div>
    <div
      class='absolute inset-0 rounded-lg h-[60%] -z-10'
      style={`background: linear-gradient(to bottom, ${playlist?.color.accent}, ${playlist?.color.accent}33 60%, transparent)`}
      transition:name=`playlist-bg`
    >
    </div>

    <section class='pt-6 px-2'>
      <PlaylistSongs playlist={playlist} songs={playlistSongs} client:load />
    </section>
  </div>
</Layout>
