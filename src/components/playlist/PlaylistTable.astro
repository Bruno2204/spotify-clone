---
import { type Song } from '@/lib/data.js';

interface Props {
  songs: Song[];
}

const { songs } = Astro.props;
---

<table class='table-auto text-left min-w-full divide-y divide-white/10'>
  <thead class=''>
    <tr class='text-gray-500 text-sm font-light'>
      <th class='px-4 py-2'>#</th>
      <th class='px-4 py-2'>Title</th>
      <th class='px-4 py-2'>Album</th>
      <th class='px-4 py-2'>Duration</th>
    </tr>
  </thead>

  <tbody>
    <tr class='h-4'></tr>
    {
      songs.map((song, index) => (
        <tr class='text-gray-400 hover:bg-white/10 transition-colors duration-200 ease-in-out'>
          <td class='px-4 py-2 rounded-l-lg w-4'>{index + 1}</td>
          <td class='px-4 py-2 flex items-center gap-2'>
            <picture>
              <img src={song.image} alt={song.title} class='w-10 h-10' />
            </picture>
            <div class='flex flex-col'>
              <h3 class='text-white text-base font-normal'>{song.title}</h3>
              <span class='text-zinc-400 text-sm font-normal'>
                {song.artists.join(', ')}
              </span>
            </div>
          </td>
          <td class='px-4 py-2'>{song.album}</td>
          <td class='px-4 py-2 rounded-r-lg'>{song.duration}</td>
        </tr>
      ))
    }
  </tbody>
</table>
