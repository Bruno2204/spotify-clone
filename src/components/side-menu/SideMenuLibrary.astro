---
import LibraryIcon from '@/icons/Library.astro';
import SideMenuCard from '@/components/side-menu/SideMenuCard.astro';

import { playlists, type Playlist } from '@/lib/data.js';
---

<section
  class='bg-section-bg text-zinc-400 font-semibold rounded-lg m-2 p-4 flex-1 flex flex-col gap-4 w-30 md:w-[350px] truncate'
>
  <span class='flex flex-row md:gap-4 gap-2.5'>
    <LibraryIcon />
    Library
  </span>
  <div class='flex flex-col gap-4'>
    {
      playlists.map((playlist: Playlist) => (
        <SideMenuCard playlist={playlist} />
      ))
    }
  </div>
</section>
