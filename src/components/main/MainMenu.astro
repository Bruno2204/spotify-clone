---
import { playlists } from '@/lib/data.js';
import MainCard from './MainCard.astro';
import Greeting from './Greeting.astro';
import MainPlaylist from './MainPlaylist.astro';
---

<div
  id='playlist-container'
  class='relative transition-all duration-1000 bg-section-bg rounded-lg z-10 w-full
  bg-linear-to-b from-green-500/70 via-green-700/30 to-section-bg/80'
>
  <div class='relative z-20 m-3 mt-6'>
    <Greeting />
    <div class='flex flex-wrap flex-row gap-x-4 gap-y-6 mt-2 w-full'>
      {playlists.map((playlist) => <MainPlaylist playlist={playlist} />)}
    </div>
    <h3 class='text-white text-2xl font-bold mt-6 mb-4'>For You</h3>

    <div class='flex flex-wrap z-10 gap-x-4 gap-y-6 mt-2 justify-start pb-4'>
      {playlists.map((playlist) => <MainCard playlist={playlist} />)}
    </div>
  </div>
  <!-- <div
    class='absolute inset-0 bg-linear-to-b from-green-500 via-green-700/30 to-section-bg/80 rounded-lg h-[60%] -z-50'
    transition:name=`playlist-bg`
  >
  </div> -->
</div>

