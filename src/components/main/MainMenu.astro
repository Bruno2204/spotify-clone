---
import Layout from '@/layouts/Layout.astro';
import { HomePage } from '@/components/main/HomePage.jsx';
import { getCharts, getTopArtists, getTopPodcasts } from '@/lib/deezer';

const [tracks, artists, podcasts] = await Promise.all([
  getCharts(),
  getTopArtists(),
  getTopPodcasts(),
]);
---

<div
  id='home-container'
  class='relative bg-section-bg rounded-lg z-10 w-full h-full contenedor'
>
  <HomePage
    client:load
    initialTracks={tracks as any}
    initialArtists={artists as any}
    initialPodcasts={podcasts as any}
  />
</div>

<style>
  .contenedor {
    overflow-y: auto;
    scrollbar-gutter: stable;
    scrollbar-color: rgba(100, 100, 100, 0.5) #1d1d1d;
    transition: scrollbar-color 0.3s ease;
  }

  .contenedor::-webkit-scrollbar {
    width: 10px;
  }

  .contenedor::-webkit-scrollbar-track {
    background: #1d1d1d;
  }

  .contenedor::-webkit-scrollbar-thumb {
    background-color: rgba(100, 100, 100, 0.5);
    border-radius: 10px;
  }

  .contenedor:hover::-webkit-scrollbar-thumb {
    background-color: rgba(104, 104, 104, 0.8);
  }

  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    scrollbar-width: none;
  }
</style>
