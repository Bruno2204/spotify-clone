---
import type { Playlist } from '@/lib/data.js';
import { CardPlayButton } from '@/components/main/CardPlayButton.jsx';
interface Props {
  playlist: Playlist;
}

const { playlist } = Astro.props;
const { id, title, cover, artists } = playlist;

const artistsString: string = artists.join(', ');
---

<article class='group relative'>
  <div
    class='absolute right-6 top-19 z-1 translate-y-2 group-hover:translate-y-0 transition-all duration-500 ease-in-out opacity-0 group-hover:opacity-100'
  >
    <CardPlayButton id={id} client:visible />
  </div>
  <a
    href={`/playlist/${id}`}
    class='flex flex-col gap-3 flex-1 h-full bg-zinc-800/80 rounded-lg transition-colors duration-300 ease-in-out z-10 group-hover:bg-white/20 backdrop-blur-sm w-32 md:w-36 p-3 select-none'
    transition:name=`playlist-${id}-box`
  >
    <picture class='aspect-squareoverflow-hidden'>
      <img
        src={cover}
        alt={title}
        class=''
        transition:name=`playlist-${id}-image`
      />
    </picture>
    <div class='flex flex-col gap-1'>
      <h3
        class='text-white text-md font-normal truncate'
        transition:name=`playlist-${id}-title`
      >
        {title}
      </h3>
      <p
        class='text-zinc-400 text-sm font-normal line-clamp-2'
        transition:name=`playlist-${id}-artists`
      >
        {artistsString}
      </p>
    </div>
  </a>
</article>
