---
import type { Playlist } from '@/lib/data.js';
import { CardPlayButton } from './CardPlayButton.jsx';
interface Props {
  playlist: Playlist;
}

const { playlist } = Astro.props;
const { id, title, cover, artists } = playlist;

const artistsString: string = artists.join(', ');
---

<article
  class='group relative flex flex-1 bg-zinc-800/60 text-nowrap hover:bg-white/20 transition-all duration-300 w-full rounded-lg'
>
  <a href={`/playlist/${id}`} class='flex flex-row gap-3 flex-1 h-24 group'>
    <picture class='aspect-square' transition:name=`playlist-${id}-image`>
      <img src={cover} alt={title} class='rounded-l-lg' />
    </picture>
    <div class='flex flex-col justify-around overflow-hidden'>
      <h3
        class='text-white text-xl font-bold truncate'
        transition:name=`playlist-${id}-title`
      >
        {title}
      </h3>
    </div>
  </a>
  <div
    class='absolute right-4 top-[25%] items-center flex-1 justify-end mr-4 opacity-1 group-hover:opacity-100 transition-all duration-300 translate-y-2 group-hover:translate-y-0'
    transition:name={`playlist-${id}-button`}
  >
    <button>
      <CardPlayButton id={id} client:load className='size-6 m-0.5' />
    </button>
  </div>
</article>
