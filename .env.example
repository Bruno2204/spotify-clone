# Database — Neon Postgres (https://neon.tech)
# 1. Create a free account at https://console.neon.tech
# 2. Create a new project (any region, default settings are fine)
# 3. Go to Project Dashboard → Connection Details
# 4. Copy the "Pooled connection" string (it ends with ?sslmode=require)
# 5. Paste it below, replacing the placeholder
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Better Auth (Phase 5 — leave empty until then)
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4321"
